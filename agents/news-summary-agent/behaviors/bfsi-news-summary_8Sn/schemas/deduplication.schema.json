{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "groupId",
          "primaryArticleId",
          "articleIds",
          "sameEventReason",
          "confidence"
        ],
        "properties": {
          "groupId": { "type": "string" },
          "primaryArticleId": { "type": "string" },
          "articleIds": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "uniqueItems": true
          },
          "sameEventReason": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
