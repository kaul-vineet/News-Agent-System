{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inputId",
    "selectedUrl",
    "headline",
    "publisher",
    "summary",
    "primaryEntity",
    "eventType",
    "action",
    "subject",
    "eventDate",
    "confidence"
  ],
  "properties": {
    "inputId": { "type": "string" },
    "selectedUrl": { "type": "string", "format": "uri" },
    "headline": { "type": "string" },
    "publisher": { "type": "string" },
    "summary": { "type": "string" },
    "primaryEntity": { "type": "string" },
    "eventType": { "type": "string" },
    "action": { "type": "string" },
    "subject": { "type": "string" },
    "eventDate": { "type": ["string", "null"] },
    "amountOrRate": { "type": ["string", "null"] },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
